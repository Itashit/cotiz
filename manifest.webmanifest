{
  "id": "./app/",
  "name": "Cotiz — copilote micro-entrepreneur",
  "short_name": "Cotiz",
  "description": "Calcule tes cotisations URSSAF, prépare ta déclaration, fais tes factures et surveille tes seuils. Tes données restent sur ton appareil.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./app/",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "orientation": "any",
  "background_color": "#fafaf9",
  "theme_color": "#fafaf9",
  "categories": [
    "finance",
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "assets/screen-dashboard.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Tableau de bord : cotisations, échéance et seuils"
    },
    {
      "src": "assets/screen-factures.png",
      "sizes": "1366x768",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Factures conformes en un clic"
    },
    {
      "src": "assets/screen-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Cotiz sur mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Ajouter une recette",
      "short_name": "Recette",
      "url": "./app/#/recettes/new",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Préparer ma déclaration",
      "short_name": "Déclarer",
      "url": "./app/#/declaration",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
